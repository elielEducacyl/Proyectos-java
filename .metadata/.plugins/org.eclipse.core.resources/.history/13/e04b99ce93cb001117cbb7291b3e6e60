	private static void listaPrimos(Scanner in) {
		System.out.println("(primos) Ingrese un numero: ");
		int num = in.nextInt();
		boolean primo;
		
		for (int i = 0; i <= num; i++) {
			primo = esPrimo(i);
			
			if (primo) {
				System.out.println(i);
			}
		}
	}
	
	private static boolean esPrimo(int num) {
		if (0 == (num % 2)) {
			return false;
		} else if (num < 2) {
			return true;
		}
		
		double raiz = Math.sqrt(num);
		
		for (int i = 2; i <= raiz; i++) {
			if (0 == (num % i)) {
				return false;
			}
		}
		return true;
	}

