	private static void ppo(Scanner in) {
		System.out.println("Quiere jugar piedra, papel o tigeras?");
		String seleccion = in.nextLine();
		int codigo = 0;
		
		switch (seleccion) {
		case "piedra":
			codigo = 1;
		case "papel":
			codigo = 2;
		case "tigeras":
			codigo = 3;
		}
		
		int aleatorio = obtenerJugadaAleatoria();
		int resultado = determinarGanador(codigo, aleatorio);
	}

	private static int determinarGanador(int x, int y) {
		switch (x) {
		case 1:
			if (y == 1) return 0;
			if (y == 2) return -1;
			if (y == 3) return 1;
			break;
		case 2:
			if (y == 1) return 1;
			if (y == 2) return 0;
			if (y == 3) return -1;
			break;
		case 3:
			if (y == 1) return -1;
			if (y == 2) return 1;
			if (y == 3) return 0;
			break;
		}
		return 0;
	}

