package ejercicios_16_10;

public class Main {
	
	static final double IVA_GENERAL = 0.21;
	
	public static void main(String[] args) {
	
		int num1 = 125;
		System.out.println("El IVA de " + num1 + " es: " + precioFinal(num1));
		System.out.println("El IVA de " + num1 + " con 4% de IVA es: " + precioFinal(num1, 0.04));
	}
	
	public static double precioFinal (double precio) {
		
		double total = 0;
		
		total = precio * ( 1 +IVA_GENERAL);
		return total;
	}
	
	public static double precioFinal (double precio, double IVA) {
		
		double total = 0;
		
		total = precio * (1 + IVA);
		
		return total;
	}
}
