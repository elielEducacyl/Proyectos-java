package elielg_20_10;

import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner in = new Scanner(System.in);
		
		int num = 0;
		boolean esCorrecto = false;
		
		do {
			System.out.println("ingrese un numero impar");
			num = in.nextInt();
			if (0 == (num%2)) {
				esCorrecto = false;
				System.out.println("Ingrese un numero impar");
			} else {
				esCorrecto = true;
			}
		} while (!esCorrecto);

		
		for (int i = 0; i <= num; i++) {
			for (int j = 1; j <= num-i ;j++) {
				imprimirVacio();
			}
			
			for(int j = 1; j <=(i * 2); j++) {
				imprimirAsterisco();
			}
		}
		
	}

	private static void imprimirAsterisco() {
		System.out.print("*");
		
	}

	private static void imprimirVacio() {
		System.out.print("-");
	}
}
