package hanoi;

public class Main {
	public static void main(String[] args) {
		int cantidad = 8;
		
		int[] varilla1 = {0, 1, 2, 3, 4, 5, 6, 7};
		int[] varilla2 = new int[7];
		int[] varilla3 = new int[7];
		
		do {
			for (int i = 0; i <= cantidad; i++) {
				if (varilla1[i] < varilla2[i]) {
					varilla2[i] = varilla1[i];
					varilla1[i] = 0;
				}else if (varilla1[i] < varilla3[i]) {
					varilla3[i] = varilla1[i];
					varilla1[i] = 0;
				}
			}
		} while (true);
	}
}
