package ejercicios_16_10;

import java.util.Scanner;

public class Main {
	
	static final double IVA_GENERAL = 0.21;
	
	public static void main(String[] args) {
		
		Scanner in = new Scanner(System.in);
	
		int num1 = 125;
		System.out.println("El IVA de " + num1 + " es: " + precioFinal(num1));
		System.out.println("El IVA de " + num1 + " con 4% de IVA es: " + precioFinal(num1, 0.04));
		
		int dias = diaMes(in);
		System.out.println("Este mes tiene: " + dias);
		
		int num2 = 5;
		factorial(num2);
	}
	
	public static double precioFinal (double precio) {
		
		double total = 0;
		
		total = precio * ( 1 +IVA_GENERAL);
		return total;
	}
	
	public static double precioFinal (double precio, double IVA) {
		
		double total = 0;
		
		total = precio * (1 + IVA);
		
		return total;
	}
	
	public static int diaMes (Scanner in) {
		
		System.out.println("Ingrese el numero del mes: ");
		int mes = in.nextInt();
		
		switch (mes) {
		case 1: // enero
			return 31;
		case 2: // febrero
			return 27;
		case 3: // marzo
			return 31;
		case 4: // abril
			return 30;
		case 5: // mayo
			return 31;
		case 6: // junio
			return 30;
		case 7: // julio
			return 31;
		case 8: // agosto
			return 31;
		case 9: // septiembre
			return 30;
		case 10: // octubre
			return 31;
		case 11: // noviembre
			return 30;
		case 12: // diciembre
			return 31;
		default:
			return 0;
		}
	}
	
	public static void saludoP (String nombre, int hora) {
		if (hora <= 12) {
			System.out.println("Buenos dias " + nombre + "!");
		} else if (hora <= 18 || hora <= 18) {
			System.out.println("Buenas tardes " + nombre + "!");
		} else if (hora >= 18) {
			System.out.println("Buenas noches " + nombre + "!");
		}
	}
	
	private static int factoria(int num) {
		if (num == 1) 
			return 1;
		return num * factoria(num - 1); 
	}
}
